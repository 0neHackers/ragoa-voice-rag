{
  "name": "Voice RAG — 0neHackers",

  // Reuse the production Dockerfile rather than a devcontainer-specific image, so what
  // runs in a Codespace is the same thing that would run on any container host.
  //
  // The index ships in the repo, so the build copies it instead of re-embedding: roughly
  // 3 minutes. It used to rebuild here, which took 48 minutes on a 2-core Codespace
  // because build_parallelism collapses to a single worker at that core count.
  "build": {
    "dockerfile": "../V9.0/Dockerfile",
    "context": "../V9.0",
    "args": { "CORPUS_LIMIT": "1500" }
  },

  // 7860 matches the Dockerfile's default PORT. "public" is what makes the forwarded
  // URL openable by a judge who isn't signed into GitHub — the default is "private",
  // which serves a login page to everyone else and looks like a broken link.
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": {
      "label": "Voice RAG",
      "visibility": "public",
      "onAutoForward": "notify"
    }
  },

  // SARVAM_API_KEY is not set here. It comes from a Codespaces secret, so it never
  // enters the repo: github.com/settings/codespaces -> New secret -> SARVAM_API_KEY,
  // scoped to this repository.
  "remoteEnv": {
    "INDEX_DIR": "/app/index_store",
    "EMBED_THREADS": "1",
    "STT_TRANSPORT": "auto",
    "PORT": "7860"
  },

  // Codespaces mounts the repo at /workspaces/<repo>, which is NOT where the image put
  // the code. The Dockerfile COPYs into /app and keeps the index there, so the app must
  // start from /app — starting it from the mounted workspace finds no index_store and
  // 503s on every request.
  //
  // Starts the app and a Cloudflare tunnel, then prints a public URL.
  //
  // Not Codespaces' own port forwarding: that reverts port visibility to private on its
  // own, returns 401 to every non-browser client, and shows anonymous visitors an
  // "about to access a development port" interstitial with no way to disable it. None of
  // that is acceptable for a link you hand to a judge. The tunnel keeps GitHub's uptime
  // and drops all three problems.
  //
  // Runs under sh, not bash: the shell in this image is dash.
  "postAttachCommand": {
    "server": "sh -lc 'cd /app 2>/dev/null || cd \"$PWD\"; nohup sh serve_public.sh > /tmp/serve.log 2>&1 & sleep 25; grep -A2 \"LIVE:\" /tmp/serve.log || (echo \"still starting — run: tail -f /tmp/serve.log\"; tail -5 /tmp/serve.log)'"
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }

  // No "remoteUser" override. The image already runs as the non-root `app` user (uid
  // 1000, which Codespaces expects); naming it again here has caused Codespaces to fail
  // its permission setup on images that don't grant that user sudo.
}
