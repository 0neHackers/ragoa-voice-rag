# ---- Speech-to-text (Sarvam AI) ----
# https://dashboard.sarvam.ai  — used by stt/sarvam_client.py
SARVAM_API_KEY=

# ---- LLM for answer generation ----
# Anthropic is the default provider (generation/llm_client.py)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: Sarvam's own chat model can be used instead of Anthropic
# LLM_PROVIDER=anthropic | sarvam | echo
LLM_PROVIDER=anthropic

# ---- Pipeline config (safe defaults; override only if you know why) ----
DATASET_LANG=hi
DATASET_SPLIT=train
CORPUS_SIZE=2000
EMBED_MODEL=intfloat/multilingual-e5-small
RETRIEVAL_TOP_K=5
