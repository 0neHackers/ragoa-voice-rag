# Secrets — never commit
.env
*/.env
**/.env

# Python
__pycache__/
*.py[cod]
.venv/
*/.venv/
**/.venv/
*.egg-info/

# Caches / build artifacts
.pytest_cache/
**/.cache/
**/hf_cache/
**/model_cache/
**/*.faiss
**/*.index
**/corpus_cache/

# Built indexes are normally artifacts — reproducible from `retrieval.build_index` — and
# stay out of git. V9.0's is the deliberate exception: baking it during a Docker build
# takes ~75 minutes on a 2-core Codespace (build_parallelism drops to 1 worker at
# 294ms/chunk), which exceeds the build timeout. Shipping the 38MB index turns that into
# a file copy. Every other version's index remains ignored.
**/index_store/
!V9.0/index_store/
!V9.0/index_store/**
**/index_store_dev/
**/build_full.log

# Local dev server log
**/server.log

# local run artifacts
.cloudflared.exe
serve.log
app.log
tunnel.log

# Timestamped benchmark runs — only results_latest.json is referenced; the rest are
# snapshots of individual runs that go stale and start contradicting the README.
**/benchmarks/results_2*.json
**/benchmarks/results_full_pipeline.json

# Generated audio (TTS output). audio_samples/tts_hi.wav is kept deliberately as the
# fixture the STT verification command uses.
**/audio_samples/answer_*.wav
