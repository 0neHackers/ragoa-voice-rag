# Secrets — never commit
.env
*/.env
**/.env

# Python
__pycache__/
*.py[cod]
.venv/
*/.venv/
**/.venv/
*.egg-info/

# Caches / build artifacts
.pytest_cache/
**/.cache/
**/hf_cache/
**/model_cache/
**/*.faiss
**/*.index
**/corpus_cache/

# Built indexes — reproducible from `python -m retrieval.build_index`
**/index_store/
**/index_store_dev/
**/build_full.log

# Local dev server log
**/server.log

# local run artifacts
.cloudflared.exe
serve.log
app.log
tunnel.log

# Timestamped benchmark runs — only results_latest.json is referenced; the rest are
# snapshots of individual runs that go stale and start contradicting the README.
**/benchmarks/results_2*.json
**/benchmarks/results_full_pipeline.json

# Generated audio (TTS output). audio_samples/tts_hi.wav is kept deliberately as the
# fixture the STT verification command uses.
**/audio_samples/answer_*.wav
