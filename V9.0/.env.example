# ---- Sarvam AI — one key drives the whole pipeline ----
# https://dashboard.sarvam.ai
# Used by: speech-to-text, answer generation, English->Hindi translation, text-to-speech.
SARVAM_API_KEY=

# ---- Optional overrides (sane defaults; change only if you know why) ----
# Speech-to-text
SARVAM_STT_MODEL=saarika:v2.5
STT_LANGUAGE_CODE=hi-IN
# auto = try streaming, fall back to batch and remember. Also: batch | streaming
STT_TRANSPORT=auto

# Answer generation. The -conversations variant is the non-reasoning one; plain
# sarvam-105b spends its whole token budget thinking and returns nothing.
SARVAM_CHAT_MODEL=sarvam-105b-conversations
GENERATION_MAX_TOKENS=300

# Translation (opt-in per request)
TRANSLATE_SOURCE=en-IN
TRANSLATE_TARGET=hi-IN

# Text-to-speech
TTS_LANGUAGE=hi-IN
TTS_SPEAKER=anushka
TTS_SAMPLE_RATE=22050

# ---- Pipeline ----
DATASET_LANG=hi
DATASET_SPLIT=validation
CORPUS_SIZE=1500
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_THREADS=1
RETRIEVAL_TOP_K=5
